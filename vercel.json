{
  "redirects": [
    { "source": "/inspiration.html", "destination": "/#weddings", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/b2c", "destination": "/api/admin?b2c=1" },
    { "source": "/api/referrals", "destination": "/api/weddings?client_referrals=1" },
    { "source": "/", "has": [{ "type": "host", "value": "(?<label>[a-z0-9-]+)\\.joinourwedding\\.site" }], "destination": "/api/guest?action=page" },
    { "source": "/w/:slug", "destination": "/api/guest?action=og&slug=:slug" }
  ],
  "functions": {
    "api/guest.js": { "includeFiles": "{guest,index}.html" },
    "api/admin.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/b2c?action=worker",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
