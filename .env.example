# Copy to the Vercel project environment settings; do not commit real values.
# Use separate Supabase projects and secrets for development, preview, and production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Checkout runs only in provider TEST/sandbox mode. Live mode is not supported by
# this build; WEDDINGSITE_LIVE_PAYMENTS_ENABLED is not consulted for test checkout
# and should stay false. Provider availability is derived from the settings below
# (organizers never pick a processor).
WEDDINGSITE_LIVE_PAYMENTS_ENABLED=false
WEDDINGSITE_PAYMENT_MODE=test
WEDDINGSITE_PUBLIC_ORIGIN=https://your-staging-domain.example
# Optional: comma-separated older platform origins still accepted during a domain move.
WEDDINGSITE_LEGACY_ORIGINS=
# Weddings are served at https://<slug>.<this domain> (e.g. joinourwedding.site).
WEDDINGSITE_WEDDING_BASE_DOMAIN=
TURNSTILE_SECRET_KEY=replace-with-server-only-turnstile-secret

# Provider-specific secrets and allow-listed markets/currencies. Configure only
# in Vercel's encrypted environment settings; test credentials are not live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORTED_CURRENCIES=
STRIPE_SUPPORTED_MARKETS=
PAYSTACK_SECRET_KEY=
PAYSTACK_SUPPORTED_CURRENCIES=
PAYSTACK_SUPPORTED_MARKETS=

# Safaricom Daraja M-Pesa STK Push — SANDBOX only (KE/KES collection).
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Live collection (default OFF; needs MODE=live, ENVIRONMENT=production, both keys below, plus Owner DB approval).
# DARAJA_LIVE_COLLECTION_ENABLED=true
# DARAJA_LIVE_SHORTCODE_CONFIRMED=<same as DARAJA_SHORTCODE>

# Required only for scheduled reminder queueing. Configure the same value as
# the Vercel Cron authorization secret; never expose it to the browser.
CRON_SECRET=replace-with-a-long-random-secret

# The Turnstile site key is public and belongs in client UI configuration only;
# the current static demo is not wired to a CAPTCHA or checkout widget.
TURNSTILE_SITE_KEY=
